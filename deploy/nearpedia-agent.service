[Unit]
Description=NEARpedia migration agent for NEAR Agent Market (polls for hires, delivers a report and a patch)
After=network.target

[Service]
Type=notify
NotifyAccess=main
WatchdogSec=180
User=root
Group=root
WorkingDirectory=/srv/nearpedia
Environment=NODE_ENV=production
Environment=NODE_OPTIONS=--dns-result-order=ipv4first
Environment=AGENT_WORKDIR=/var/lib/nearpedia-agent
EnvironmentFile=-/srv/nearpedia/.env.production
ExecStart=/root/.nvm/versions/node/v22.18.0/bin/node --import tsx scripts/agent-market-worker.ts
Restart=on-failure
RestartSec=30
StandardOutput=journal
StandardError=journal
SyslogIdentifier=nearpedia-agent
NoNewPrivileges=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
SystemCallArchitectures=native

[Install]
WantedBy=multi-user.target
