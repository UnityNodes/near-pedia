# nearpedia env vars — copy to .env.production on the VPS, fill real
# values, chmod 600. Never commit a populated copy.
#
# Read on startup by nearpedia.service (EnvironmentFile=).

# ── LLM providers (cascade order: Gemini → Cohere → Groq → OpenAI) ──
GEMINI_API_KEY=
COHERE_API_KEY=
GROQ_API_KEY=

# ── Embeddings for semantic search (OpenAI text-embedding-3-small) ──
OPENAI_API_KEY=
# Optional, unused by the default embedder
VOYAGE_API_KEY=

# ── Rerank for semantic search: Cloudflare Workers AI bge-reranker-base
# (token with "Workers AI: Read"). COHERE_API_KEY above is used only when
# Cloudflare is not configured; a Cloudflare failure keeps the hybrid order.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AI_TOKEN=

# ── GitHub sync: REQUIRED in production (read-only, public repos) ──
# Without it the 60 calls/hour limit runs out inside one releases + repos
# cycle, and conditional 304s still count against it.
GITHUB_TOKEN=

# ── Optional: Prometheus /api/metrics auth ─────────────────────────
# Leave unset when Prometheus scrapes from a private network.
# METRICS_TOKEN=

# ── Optional: MCP server port (default 3131) ───────────────────────
# MCP_PORT=3131

# ── Required in production: public origin ──────────────────────────
# Every canonical, sitemap, feed and MCP link is built from it; unset, they
# all point at localhost.
NEXT_PUBLIC_SITE_URL=

# ── Optional: Service Worker feature flag ──────────────────────────
# NEXT_PUBLIC_SW=1

# ── Optional: bake-in build timestamp (used in /api/health) ────────
# BUILD_TIME=2026-06-04T09:00:00Z

# ── Optional: alerting webhooks (scripts/check-sync-staleness.sh) ──
# SLACK_WEBHOOK_URL=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# ── Contact form (Gmail SMTP) ──────────────────────────────────────
# SMTP_USER = sending mailbox (e.g. contact@example.com, Google
#             alias that lands in your real Gmail inbox).
# SMTP_PASS = Google App Password (16 chars, NOT your account password).
#             Generate at: Google Account -> Security -> 2-Step
#             Verification -> App passwords -> Mail / Other(nearpedia).
# CONTACT_RECIPIENT_EMAIL = where /api/contact delivers messages.
#             Defaults to SMTP_USER if unset.
# SMTP_HOST defaults to smtp.gmail.com.
# SMTP_PORT defaults to 587 (STARTTLS) — most VPS hosts (Hetzner, OVH,
#           DO, AWS) block outbound 465. Override only if your host
#           explicitly permits 465.
SMTP_USER=
SMTP_PASS=
CONTACT_RECIPIENT_EMAIL=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587

# ── Monitoring: Plausible analytics + GlitchTip/Sentry errors ──────
# Self-hosted on the shared *.example.com stack. The Plausible script
# host and the CSP allow-list / report-uri live in components/plausible.tsx
# and middleware.ts. These NEXT_PUBLIC_* values are public (shipped to the
# browser) — the Sentry DSN key is a public ingest key, not a secret.
# Replace YOUR_PROJECT_KEY and YOUR_PROJECT_ID with your own GlitchTip project values.
NEXT_PUBLIC_SENTRY_DSN=https://YOUR_PROJECT_KEY@errors.example.com/YOUR_PROJECT_ID
NEXT_PUBLIC_SENTRY_ENV=production

# Failure alerts (scripts/check-failures.ts, every 5 minutes in the fast bucket).
# A failing source or tool pages here; the message is deleted once the failure is
# resolved (Discord and Telegram). Callers' mistakes arrive as one daily digest.
# OPS_DISCORD_WEBHOOK_URL=
# OPS_SLACK_WEBHOOK_URL=
# OPS_TELEGRAM_CHAT_ID=
# OPS_TELEGRAM_BOT_TOKEN=
